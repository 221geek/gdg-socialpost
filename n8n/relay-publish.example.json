{
  "name": "Relay — publication dispatch",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "relay-publish",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "name": "Relay dispatch",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "id": "secret", "leftValue": "={{ $json.headers['x-relay-secret'] }}", "rightValue": "={{ $env.N8N_RELAY_SHARED_SECRET }}", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate",
      "name": "Validate Relay secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": { "jsCode": "// Route $json.body.destinations to the provider nodes here.\n// Keep each platform branch idempotent using $json.body.publicationId.\nreturn [{ json: $json.body }];" },
      "id": "dispatch",
      "name": "Dispatch to platforms",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 250]
    }
  ],
  "connections": {
    "Relay dispatch": { "main": [[{ "node": "Validate Relay secret", "type": "main", "index": 0 }]] },
    "Validate Relay secret": { "main": [[{ "node": "Dispatch to platforms", "type": "main", "index": 0 }], []] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "relay-publish-v1"
}
