# Use this file when the API and worker target the hosted n8n instance.
API_PORT=4000
WEB_ORIGIN=https://app.example.com
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/relay?retryWrites=true&w=majority
REDIS_URL=rediss://<user>:<password>@<host>:<port>
N8N_PUBLISH_WEBHOOK_URL=https://n8n-gdg.abdoulazizdione.cloud/webhook/relay-publish
# Generate with: openssl rand -hex 32. Configure the same secret in n8n Header Auth before production.
N8N_SHARED_SECRET=replace-with-a-64-character-random-secret
